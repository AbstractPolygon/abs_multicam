{
  "name": "abs-multicam",
  "productName": "ABS_MultiCam",
  "version": "0.1.0",
  "description": "View and loop-record any number of USB webcams at once (Windows, macOS, Linux).",
  "main": "main.js",
  "license": "PolyForm-Shield-1.0.0",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "node scripts/smoke.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.cheapcamhack.abs-multicam",
    "productName": "ABS_MultiCam",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "updates.js",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "ABS_MultiCam needs camera access to show and record your webcams."
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "AudioVideo",
      "maintainer": "AbstractPolygon <noreply@github.com>",
      "synopsis": "Multi-camera preview and loop recorder",
      "description": "View and loop-record any number of USB webcams at once."
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "AbstractPolygon",
        "repo": "abs_multicam"
      }
    ],
    "deb": {
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64"
      ]
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "pixelmatch": "^5.3.0"
  },
  "homepage": "https://github.com/AbstractPolygon/abs_multicam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbstractPolygon/abs_multicam.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0"
  },
  "author": "AbstractPolygon",
  "desktopName": "abs-multicam.desktop"
}
